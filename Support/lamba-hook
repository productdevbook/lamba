#!/usr/bin/env python3
"""Lamba hook for Claude Code on a remote machine (reached over SSH).

Claude Code runs this from its hooks; it reports to Lamba on your Mac through the Unix socket
that `ssh` forwards (RemoteForward, set up by `lamba ssh-setup <host>`). Lamba works out which
Terminal tab the SSH session lives in, so clicking Claude's Dock capsule opens it.

Usage (from Claude Code hooks, hook JSON on stdin):
    lamba-hook working | tool | permission | waiting | done

Never blocks or breaks Claude: if Lamba can't be reached, it exits quietly.
"""
import getpass
import json
import os
import socket
import sys

SOCKET = os.environ.get("LAMBA_SOCKET", f"/tmp/lamba-{getpass.getuser()}.sock")
MAX_TARGET = 48


def target_of(tool_input):
    def get(key):
        value = tool_input.get(key)
        return value if isinstance(value, str) and value else None

    path = get("file_path") or get("notebook_path") or get("path")
    if path:
        value = os.path.basename(path.rstrip("/"))
    elif get("url"):
        from urllib.parse import urlparse
        value = urlparse(get("url")).hostname or get("url")
    else:
        value = get("description") or get("command") or get("pattern") or get("query") or get("prompt")
    if value is None:
        return None
    value = value.replace("\n", " ")
    return value if len(value) <= MAX_TARGET else value[: MAX_TARGET - 1] + "…"


def session_title(path):
    """Last /rename title or generated title from the transcript's tail."""
    try:
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            f.seek(max(0, f.tell() - 512 * 1024))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except Exception:
        return None
    ai_title = None
    for line in reversed(lines):
        if '-title"' not in line:
            continue
        try:
            entry = json.loads(line)
        except Exception:
            continue
        if entry.get("type") == "custom-title" and entry.get("customTitle"):
            return entry["customTitle"]
        if ai_title is None and entry.get("type") == "ai-title" and entry.get("aiTitle"):
            ai_title = entry["aiTitle"]
    return ai_title


def send(request, timeout):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as connection:
        connection.settimeout(timeout)
        connection.connect(SOCKET)
        connection.sendall(json.dumps(request).encode() + b"\n")
        data = b""
        while b"\n" not in data:
            chunk = connection.recv(65536)
            if not chunk:
                break
            data += chunk
    return json.loads(data.split(b"\n")[0] or b"{}")


def main():
    action = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        hook = json.load(sys.stdin)
    except Exception:
        hook = {}
    session = hook.get("session_id")
    folder = os.path.basename(hook.get("cwd") or os.getcwd())
    # pid 0: Lamba fills in the terminal from the SSH connection; the machine name may be
    # replaced by the SSH alias Lamba knows it by.
    host = {"pid": 0, "folder": folder, "machine": socket.gethostname().split(".")[0]}
    name = session_title(hook["transcript_path"]) if hook.get("transcript_path") else None
    if name:
        host["name"] = name
    detail = None
    if hook.get("tool_name"):
        detail = {"tool": hook["tool_name"]}
        target = target_of(hook.get("tool_input") or {})
        if target:
            detail["target"] = target

    try:
        if action == "permission" and hook.get("tool_name") in ("AskUserQuestion", "ExitPlanMode"):
            return
        if action == "permission":
            response = send({"permission": {"session": session, "detail": detail or {"tool": "Tool"}, "host": host}}, 590)
            decision = response.get("decision")
            if decision in ("allow", "deny"):
                verdict = {"behavior": decision}
                if decision == "deny":
                    verdict["message"] = "Denied from the Lamba Dock."
                print(json.dumps({"hookSpecificOutput": {"hookEventName": "PermissionRequest", "decision": verdict}}))
        elif action == "waiting" and (hook.get("notification_type") == "idle_prompt"
                                      or "waiting for your input" in (hook.get("message") or "").lower()):
            return  # idle reminder after a finished turn, not a request
        elif action in ("working", "tool", "waiting", "done"):
            event = "working" if action == "tool" else action
            request = {"event": event, "session": session, "host": host}
            if action == "tool" and detail:
                request["detail"] = detail
            send({"agent": request}, 3)
    except Exception:
        pass  # Lamba not reachable (no SSH forward, Mac asleep): stay out of Claude's way.


if __name__ == "__main__":
    main()
